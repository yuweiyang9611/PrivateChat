{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Host=postgres;Database=privatechat;Username=privatechat;Password=change-me"
  },
  "App": {
    "PublicUrl": "https://chat.example.com",
    "AdminEmail": "",
    "DataRoot": "/data",
    "SkipMigrate": false
  },
  "CloudflareAccess": {
    "TeamDomain": "",
    "Audience": ""
  },
  "CloudflareRealtime": {
    "BaseUrl": "https://rtc.live.cloudflare.com/v1",
    "AppId": "",
    "AppSecret": "",
    "TurnKeyId": "",
    "TurnApiToken": "",
    "TurnCredentialTtlSeconds": 86400
  },
  "WebPush": {
    "Subject": "mailto:admin@example.com"
  },
  "AllowedHosts": "*"
}
