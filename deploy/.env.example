# 复制为 .env 手动填写，或运行 ./init-env.sh（Linux/macOS）/ ./init-env.ps1（Windows）交互生成
DOMAIN=chat.example.com
ADMIN_EMAIL=you@example.com          # 该邮箱登录后自动成为管理员；也作为 Web Push 联系人
ADMIN_PASSWORD=                      # 可选：局域网 8080 直连（无 Access）时管理员的密码登录
TUNNEL_TOKEN=                        # Zero Trust → Networks → Tunnels 创建隧道后得到
CF_ACCESS_TEAM=yourteam              # Zero Trust 团队名：https://yourteam.cloudflareaccess.com 里的 yourteam
CF_ACCESS_AUD=                       # Access 应用的 Application Audience (AUD) Tag
CF_REALTIME_APP_ID=                  # Cloudflare 控制台 → Realtime → SFU 应用
CF_REALTIME_APP_SECRET=
CF_TURN_KEY_ID=                      # Realtime → TURN 密钥
CF_TURN_KEY_API_TOKEN=
POSTGRES_PASSWORD=change-me
# 设备令牌签名密钥与 Web Push（VAPID）密钥由 api 首次启动自动生成，保存在 data 卷的 /data/keys 下
