# PrivateChat api 镜像（草案；项目路径随骨架落地后确认）
FROM mcr.microsoft.com/dotnet/sdk:11.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/PrivateChat.Api -c Release -o /app

# 运行时带 ffmpeg 做缩略图与转码
FROM mcr.microsoft.com/dotnet/aspnet:11.0
ARG UBUNTU_MIRROR_HOST
RUN sed -Ei \
      -e "s|^URIs: https?://archive\.ubuntu\.com/|URIs: https://${UBUNTU_MIRROR_HOST:-archive.ubuntu.com}/|" \
      -e "s|^URIs: https?://security\.ubuntu\.com/|URIs: https://${UBUNTU_MIRROR_HOST:-security.ubuntu.com}/|" \
      /etc/apt/sources.list.d/ubuntu.sources \
 && apt-get -o Acquire::Retries=3 update --error-on=any \
 && apt-get -o Acquire::Retries=3 install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_URLS=http://0.0.0.0:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "PrivateChat.Api.dll"]
