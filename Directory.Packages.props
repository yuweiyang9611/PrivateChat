<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <!-- 被控端程序自带的 TLS 1.3（Windows 10 没有系统级的 TLS 1.3）。安全相关的依赖：版本固定，升级前看发布说明和安全公告 -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- 被控端把电脑播放的声音编成 Opus（libopus 的纯托管移植，只处理本机的声音数据）。
         固定在 2.2.2（2024-05 发布，用了两年多）：2.2.3 是 2026-11-17 才发的，观察一阵再升 -->
    <PackageVersion Include="Concentus" Version="2.2.2" />
    <!-- 被控端的 WebRTC（远程协助的快速线路，画面和声音经 Cloudflare Realtime）。纯托管，DTLS / SRTP 用的就是上面那份 BouncyCastle。
         许可证是 BSD-3 外加一条地域限制（见包里的 LICENSE.md）。收发网络数据的依赖：版本固定，升级前看发布说明。
         用的是预发布版：稳定版 10.0.17 接不住 SFU 发来的"要关键帧"和"丢了哪些包"（中途加入的浏览器一帧都解不出来），
         10.0.19-pre 才改好。等 10.0.18 以后的稳定版出来就换过去，换完跑一遍 web/e2e/remote.cjs 的 realtime 用例 -->
    <PackageVersion Include="SIPSorcery" Version="10.0.19-pre" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
    <!-- EF Core 先留在 10.x（net11.0 上照常运行）：Npgsql.EntityFrameworkCore.PostgreSQL 10.x 跑在 EF Core 11 上会抛
         MissingMethodException，它的 11.0 还只有 RC，EFCore.NamingConventions 也还没有 11.x。
         两者出正式版后，EF Core 三个包和它们一起升到 11。 -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.7" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="tusdotnet" Version="2.12.0" />
    <PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="15.1.0" />
    <PackageVersion Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
