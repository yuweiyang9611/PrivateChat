<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- 编进来的 Agent\Nv12.cs 用了指针 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PrivateChat.Api\PrivateChat.Api.csproj" />
  </ItemGroup>

  <!-- 被控端自动升级里不碰网络和进程的那部分（读清单、比版本、核对文件）：同样把源文件编进来测 -->
  <ItemGroup>
    <Compile Include="..\..\src\PrivateChat.Agent\UpdateManifest.cs" Link="Agent\UpdateManifest.cs" />
  </ItemGroup>

  <!-- 被控端程序是 net11.0-windows 的 WinForms 程序，这个测试项目引用不了它。
       其中"连不上服务器是什么原因"那一块是纯逻辑、只用到基础类库：直接把源文件编进来测。 -->
  <ItemGroup>
    <Compile Include="..\..\src\PrivateChat.Agent\ConnectionDiagnosis.cs" Link="Agent\ConnectionDiagnosis.cs" />
    <!-- 远程画面的码率控制和画质规划、声音的响度拉平：同样是纯计算 -->
    <Compile Include="..\..\src\PrivateChat.Agent\Session\RateControl.cs" Link="Agent\RateControl.cs" />
    <Compile Include="..\..\src\PrivateChat.Agent\Session\QualityPlanner.cs" Link="Agent\QualityPlanner.cs" />
    <Compile Include="..\..\src\PrivateChat.Agent\Audio\AudioLeveler.cs" Link="Agent\AudioLeveler.cs" />
    <!-- 画质设置、自动档的分辨率（用到 FrameSource.cs 里的 FrameGeometry.Fit）：同样是纯计算 -->
    <Compile Include="..\..\src\PrivateChat.Agent\Session\VideoSettings.cs" Link="Agent\VideoSettings.cs" />
    <Compile Include="..\..\src\PrivateChat.Agent\Session\AutoResolution.cs" Link="Agent\AutoResolution.cs" />
    <Compile Include="..\..\src\PrivateChat.Agent\Video\FrameSource.cs" Link="Agent\FrameSource.cs" />
    <!-- 桌面复制截屏里的纯计算：变化区域 → 画面上的块、画鼠标指针（拿 Nv12.cs 的 BGRA → NV12 对照颜色公式；它用了指针，要允许 unsafe） -->
    <Compile Include="..\..\src\PrivateChat.Agent\Video\CaptureTiles.cs" Link="Agent\CaptureTiles.cs" />
    <Compile Include="..\..\src\PrivateChat.Agent\Video\Dxgi\CursorOverlay.cs" Link="Agent\CursorOverlay.cs" />
    <Compile Include="..\..\src\PrivateChat.Agent\Video\Nv12.cs" Link="Agent\Nv12.cs" />
    <!-- 选编码器、硬件编码器逐帧 QP 的换算、认"这一帧的输出"：同样是纯计算（IVideoEncoder.cs 里是接口和 ValidatedEncoder） -->
    <Compile Include="..\..\src\PrivateChat.Agent\Video\IVideoEncoder.cs" Link="Agent\IVideoEncoder.cs" />
    <Compile Include="..\..\src\PrivateChat.Agent\Video\EncoderChoice.cs" Link="Agent\EncoderChoice.cs" />
    <!-- 遥测：一次远程里被控端这边的汇总（百分位、每样用了几秒、计数）：同样是纯计算 -->
    <Compile Include="..\..\src\PrivateChat.Agent\Session\SessionTelemetry.cs" Link="Agent\SessionTelemetry.cs" />
    <!-- 快速线路（经 Cloudflare Realtime）里的纯计算：H.264 的 RTP 分片、码率控制 -->
    <Compile Include="..\..\src\PrivateChat.Agent\Realtime\H264Rtp.cs" Link="Agent\H264Rtp.cs" />
    <Compile Include="..\..\src\PrivateChat.Agent\Session\RealtimeRateControl.cs" Link="Agent\RealtimeRateControl.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
