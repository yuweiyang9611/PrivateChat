<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PrivateChat.Api\PrivateChat.Api.csproj" />
  </ItemGroup>

  <!-- 被控端自动升级里不碰网络和进程的那部分（读清单、比版本、核对文件）：同样把源文件编进来测 -->
  <ItemGroup>
    <Compile Include="..\..\src\PrivateChat.Agent\UpdateManifest.cs" Link="Agent\UpdateManifest.cs" />
  </ItemGroup>

  <!-- 被控端程序是 net11.0-windows 的 WinForms 程序，这个测试项目引用不了它。
       其中"连不上服务器是什么原因"那一块是纯逻辑、只用到基础类库：直接把源文件编进来测。 -->
  <ItemGroup>
    <Compile Include="..\..\src\PrivateChat.Agent\ConnectionDiagnosis.cs" Link="Agent\ConnectionDiagnosis.cs" />
    <!-- 远程画面的码率控制和画质规划、声音的响度拉平：同样是纯计算 -->
    <Compile Include="..\..\src\PrivateChat.Agent\Session\RateControl.cs" Link="Agent\RateControl.cs" />
    <Compile Include="..\..\src\PrivateChat.Agent\Session\QualityPlanner.cs" Link="Agent\QualityPlanner.cs" />
    <Compile Include="..\..\src\PrivateChat.Agent\Audio\AudioLeveler.cs" Link="Agent\AudioLeveler.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
