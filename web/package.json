    "element-plus": "^2.14.7",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.1.0",
    "tus-js-client": "^4.3.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
